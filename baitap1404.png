<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kiểm tra</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            margin: 0 20px;
            padding: 0;
            font-size: 16px;
        }

        .nav {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            grid-template-rows: 60px;
        }

        .menu {
            display: flex;
            justify-content: space-around;
            align-items: center;
            position: relative;
        }

        .menu a {
            text-decoration: none;
            color: black;
        }

        .logo img {
            margin-top: 5px;
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: flex;
            align-items: center;
        }

        .tk {
            display: flex;
            align-items: center;
        }

        .tk input {
            padding: 5px 10px;
            border: 1px solid #ccc;
            border-radius: 5px
        }

        .catelog img
